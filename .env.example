# --- public: safe in the browser -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# whichever your project issues — publishable (new) or anon (older)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- server only: NEVER prefixed NEXT_PUBLIC_ ------------------------
# the shared passcode for the entry desk
ENTRY_PASSCODE=change-me
# Supabase secret key (Project Settings -> API). Bypasses RLS.
SUPABASE_SECRET_KEY=sb_secret_...
